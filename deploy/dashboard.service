# /etc/systemd/system/oa-pipeline.service
# Generated by deploy/server_bootstrap.sh — do not edit directly.
# To install manually:
#   cp deploy/dashboard.service /etc/systemd/system/oa-pipeline.service
#   systemctl daemon-reload && systemctl enable --now oa-pipeline

[Unit]
Description=OA Pipeline (FastAPI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/oa-pipeline
ExecStart=/opt/oa-pipeline/venv/bin/uvicorn api.main:app \
    --host 127.0.0.1 --port 8000 --workers 1 \
    --no-access-log
Restart=on-failure
RestartSec=5

# Set these environment variables before installing:
Environment=SECRET_KEY=CHANGE_ME_generate_with_python3_-c_import_secrets_print_secrets.token_hex_32
Environment=PIPELINES_BASE_DIR=/opt/oa-pipeline/data/pipelines
Environment=META_DB_PATH=/opt/oa-pipeline/data/dashboard.db
Environment=GZ_FILES_BASE_DIR=/root/data/openalex/works

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
