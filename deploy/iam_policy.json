{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPublicOpenAlex",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::openalex", "arn:aws:s3:::openalex/*"]
    },
    {
      "Sid": "PipelineBucket",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket",
                 "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": ["arn:aws:s3:::liel-oa-pipeline", "arn:aws:s3:::liel-oa-pipeline/*"]
    }
  ]
}
