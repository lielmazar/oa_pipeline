# AWS settings for running the pipeline from your machine with deploy/remote.py.
#
# Lines tagged [console] must match something you created in the AWS console;
# the comment says where to find it. Everything else is a plain default.
# Personal overrides go in deploy/aws.local.env (gitignored); real environment
# variables override both files. ${VAR} references are expanded.

# =========================================================================
# Your machine
# =========================================================================

# [console] IAM → Users → oa-pipeline-dev → Security credentials → Create access key
# (Command Line Interface). Saved locally with `aws configure` (or `aws configure --profile NAME`).
# The user needs two policies: oa-pipeline-s3 (deploy/iam_policy.json) and
# oa-pipeline-operator (deploy/iam_policy_operator.json).
# Empty = the default profile.
AWS_PROFILE=

# [console] Region shown in S3 → your bucket → Properties → AWS Region.
# Keep us-east-1: the public OpenAlex bucket is there, so copies have no transfer charge.
AWS_REGION=us-east-1

# =========================================================================
# Storage
# =========================================================================

# [console] S3 → Buckets → the bucket name you created.
# Must also match the "PipelineBucket" resource in deploy/iam_policy.json.
OA_BUCKET=liel-oa-pipeline

# Where snapshots and runs live inside the bucket (passed to the pipeline on the instance).
OA_STORAGE_ROOT=s3://${OA_BUCKET}/openalex

# Default run name for stages 2/3 (each launch can pass --run-id to override).
OA_RUN_ID=sustainable-fuels-v1

# =========================================================================
# EC2 instance launched for each job
# =========================================================================

# [console] IAM → Roles → the role for EC2 (with oa-pipeline-s3 attached).
# The console creates an instance profile with the same name as the role.
EC2_INSTANCE_PROFILE=oa-pipeline-ec2

# Instance size. c6id.2xlarge (8 vCPU) for smoke tests, c6id.8xlarge (32 vCPU) for full runs.
# "d" types have local NVMe, used as scratch space.
EC2_INSTANCE_TYPE=c6id.2xlarge

# true = Spot pricing (often ~60% cheaper). If AWS reclaims the instance, re-launch: stages resume.
EC2_SPOT=false

# Root disk (GB). Scratch data goes to the instance NVMe disk when the type has one.
EC2_ROOT_VOLUME_GB=30

# true = terminate the instance when the job ends (success or failure). false keeps it for debugging.
EC2_AUTO_TERMINATE=true

# Safety net: the instance shuts down after this many hours no matter what.
EC2_MAX_HOURS=12

# Ubuntu 24.04 image, looked up from AWS's public parameter store (no console setup).
EC2_AMI_PARAMETER=/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id

# [console] VPC → Subnets. Empty = a default subnet of your default VPC.
# The subnet must give the instance internet access (public IP, or a NAT gateway):
# it downloads Ubuntu packages and Python libraries at start-up.
EC2_SUBNET_ID=

# [console] EC2 → Security Groups. Empty = the VPC's default group.
# No inbound rules are needed; outbound HTTPS must be allowed (the default group allows all outbound).
EC2_SECURITY_GROUP_ID=

# [console] EC2 → Key pairs (e.g. oa-aws-test-ec2). Optional: only for SSH debugging of a kept instance.
EC2_KEY_NAME=

# Name tag shown in the EC2 console.
EC2_NAME_TAG=oa-pipeline
