{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LaunchAndWatchJobInstances",
      "Effect": "Allow",
      "Action": ["ec2:RunInstances", "ec2:CreateTags", "ec2:DescribeInstances",
                 "ec2:TerminateInstances", "ec2:GetConsoleOutput"],
      "Resource": "*"
    },
    {
      "Sid": "AttachTheInstanceRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/oa-pipeline-ec2"
    },
    {
      "Sid": "CheckTheInstanceProfile",
      "Effect": "Allow",
      "Action": "iam:GetInstanceProfile",
      "Resource": "arn:aws:iam::*:instance-profile/oa-pipeline-ec2"
    },
    {
      "Sid": "SpotServiceRoleOnFirstUse",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {"StringEquals": {"iam:AWSServiceName": "spot.amazonaws.com"}}
    },
    {
      "Sid": "LookUpUbuntuImage",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:*::parameter/aws/service/canonical/*"
    }
  ]
}
