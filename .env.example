# Copy to ".env" and fill in secrets. Keep ".env" private (gitignored).
# deploy\deploy.ps1 copies repo-root ".env" to /opt/oa-pipeline/data/.env on the server.
# systemd loads that file (optional) alongside generated SECRET_KEY in deploy/server_bootstrap.sh.

# --- Required for LLM classification (OpenAI Batch API) ---
OPENAI_API_KEY=

# --- Session signing (override dev default; use a long random string in production) ---
# On Ubuntu deploy, bootstrap may also set SECRET_KEY via /opt/oa-pipeline/data/.secret_key.
SECRET_KEY=dev-secret-change-in-production

# --- Data locations (defaults in api/config.py; systemd also sets paths on deploy) ---
# PIPELINES_BASE_DIR=/opt/oa-pipeline/data/pipelines
# META_DB_PATH=/opt/oa-pipeline/data/dashboard.db
# OpenAlex .gz partitions — server bootstrap defaults this to /root/data/openalex/works; set here to override.
# GZ_FILES_BASE_DIR=/root/data/openalex/works

# --- Processing ---
# FILTERING_WORKERS=16

# --- Optional: cap unprocessed rows per LLM batch submit when the client omits limit ---
# OA_LLM_BATCH_DEFAULT_LIMIT=
# LLM_BATCH_DEFAULT_LIMIT=

# --- Optional: session / DB browser tuning ---
# SESSION_COOKIE_NAME=session
# SESSION_MAX_AGE_DAYS=7
# DB_PAGE_SIZE=100
# DB_QUERY_MAX_ROWS=5000
